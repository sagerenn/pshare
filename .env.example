# pshare — public, no-login temporary sharing

# The OpenList backend pshare talks to. pshare proxies all file operations
# through this single instance using the credentials below; visitors never
# log in and never see OpenList directly.
OPENLIST_BASE_URL=http://127.0.0.1:5246
# OpenList username/password pshare logs in as. A dedicated guest or admin
# account whose token is cached server-side and never sent to the browser.
OPENLIST_USERNAME=admin
OPENLIST_PASSWORD=admin
# Mount path inside OpenList where pshare stores all shared files.
OPENLIST_MOUNT_PATH=/pshare
# Local folder the OpenList "Local" driver is rooted at (used by the
# integration/e2e harness to bootstrap a storage; in production you mount
# this yourself in the OpenList admin panel).
OPENLIST_LOCAL_ROOT=./data/localroot

# pshare metadata database (share ids, expiry, download counts).
PSHARE_DB=./data/pshare.db
# Port the Next.js app listens on.
PORT=3000
# Default share lifetime in seconds (1 hour). Per-share expiry is chosen by
# the uploader from a preset list.
PSHARE_DEFAULT_TTL=3600
# Max upload size in bytes (100 MiB). Enforced before streaming to OpenList.
PSHARE_MAX_BYTES=104857600
# Reaper: how often (ms) the background cleanup job runs.
PSHARE_REAPER_INTERVAL_MS=60000
