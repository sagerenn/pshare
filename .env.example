# pshare — public, no-login temporary sharing (static site)
#
# pshare is a fully static site with no backend. These NEXT_PUBLIC_* vars are
# inlined into the static bundle at BUILD time (there is no runtime server to
# read env from). Set them when running `npm run build` or as Docker build
# args. The API key is a non-admin OpenList user's key scoped to
# fs.put / fs.get / fs.rm with listing disabled — mint one with
# `node scripts/provision-key.js`.

# OpenList backend URL the browser talks to directly.
NEXT_PUBLIC_OPENLIST_BASE_URL=http://127.0.0.1:5246

# Scoped API key for the non-admin pshare user (baked into the bundle).
NEXT_PUBLIC_OPENLIST_API_KEY=

# Mount path inside OpenList where pshare stores shared files.
NEXT_PUBLIC_OPENLIST_MOUNT_PATH=/pshare

# Max upload size in bytes (100 MiB). Enforced client-side as a courtesy.
NEXT_PUBLIC_PSHARE_MAX_BYTES=104857600

# Default per-share TTL in seconds, and its human label. Used when the
# uploader picks "default"; the OpenList user's TTL setting applies then.
NEXT_PUBLIC_PSHARE_DEFAULT_TTL=86400
NEXT_PUBLIC_PSHARE_DEFAULT_TTL_LABEL=1 day
